# Python
__pycache__/
*.py[cod]
.venv/
.mypy_cache/
.ruff_cache/
.pytest_cache/
# Estado local de DeepEval (extra `evals`)
.deepeval/
*.egg-info/
dist/
build/

# Secretos
.secrets/
.env
.env.*
!.env.example

# Datos generados (se regeneran con scripts/generate_synthetic_data.py)
data/synthetic/*
!data/synthetic/.gitkeep
data/benchmarks/

# IaC
.terraform/
*.tfstate
*.tfstate.*
*.tfplan
# Valores personales (suscripción, email): se versiona solo la plantilla.
*.tfvars
!*.tfvars.example

# Experimentos A/B (fase 12.7): los runs locales (JSONL y MLflow) no se versionan; el informe sí.
.experiments/
.mlflow/
mlruns/

# Pruebas de carga (fase 10.7): se versionan el informe y los CSV de resumen, no el detalle.
evals/reports/load/*_stats_history.csv
evals/reports/load/*_exceptions.csv
evals/reports/load/*.html

# Claude Code: ajustes personales (rutas absolutas de az/gcloud aislados). Se versionan
# settings.json (permisos compartidos), rules/ y skills/.
.claude/settings.local.json

# IDE / SO
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
Thumbs.db

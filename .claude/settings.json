{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(git add *)",
      "Bash(git status *)",
      "Bash(git log *)",
      "Bash(git --no-pager *)",
      "Bash(git diff *)",
      "Bash(gh run *)",
      "Bash(gh pr view *)",
      "Bash(gh pr list *)",
      "Bash(uv *)",
      "Bash(sleep *)"
    ],
    "deny": [
      "Bash(gh pr merge *)",
      "Bash(git push origin main*)",
      "Bash(git push -f *)",
      "Bash(git push --force *)",
      "Bash(git commit --no-verify *)",
      "Bash(git commit -n *)",
      "Bash(docker compose down -v*)",
      "Bash(docker compose * down -v*)",
      "Bash(git branch -d *)",
      "Bash(git branch -D *)"
    ],
    "ask": [
      "Bash(git reset *)",
      "Bash(git restore *)",
      "Bash(git checkout -- *)",
      "Bash(git clean *)",
      "Bash(terraform *plan*)",
      "Bash(terraform *apply*)",
      "Bash(terraform *destroy*)",
      "Bash(terraform *import*)",
      "Bash(terraform *state*)",
      "Bash(az login*)",
      "Bash(az account set*)",
      "Bash(gcloud auth *)",
      "Bash(gcloud config set *)",
      "Bash(docker compose down*)",
      "Bash(docker volume rm *)",
      "Bash(docker system prune*)",
      "Bash(winget install *)",
      "Bash(rm -rf *)",
      "Bash(uv run python scripts/generate_synthetic_data.py *)"
    ]
  }
}

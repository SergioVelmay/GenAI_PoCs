# Copiar a terraform.tfvars (ignorado por Git) y rellenar. Antes de plan/apply:
#   $env:CLOUDSDK_CONFIG = "$env:USERPROFILE\.gcloud-genaipocs" ; gcloud config list
#   gcloud auth application-default login   (ADC de usuario; nunca claves JSON)

project_id      = "genaipocs-dev-xxxxxx"    # gcloud config get-value project
billing_account = "000000-000000-000000"   # gcloud billing accounts list
region          = "europe-west4"           # RAG Engine GA; misma región para todo

# Presupuesto del proyecto en la moneda de la cuenta de facturación. Mide el gasto bruto (sin
# descontar créditos de prueba): si no, las alertas no saltarían hasta agotar los créditos.
budget_email            = "tu-correo@example.com"
budget_limit            = 100
budget_alert_thresholds = [50, 75, 100] # gasto real; además, previsión al 100 %

# Quién puede suplantar la cuenta de servicio de la aplicación desde local.
developer_members = ["user:tu-correo@example.com"]

# Workload Identity Federation para GitHub Actions (gratis). Solo main obtiene credenciales.
ci_federation_enabled = true
ci_allowed_refs       = ["refs/heads/main"]

# Colección de Agent Retrieval del carril B (3.G2). Efímera: true solo durante la sesión de
# validación y false al terminar (borra la colección y sus datos).
vector_search_enabled = false

# RAG Engine del carril A (3.G3): Basic (Spanner por horas) durante la sesión; false al terminar
# = Unprovisioned (borra los datos y para la facturación).
rag_engine_enabled = false

# Agent Search del carril A (4.G3): pago por consulta (Enterprise + respuestas generativas), sin
# coste por hora; aun así, false al terminar (borra el índice; se reimporta con FULL).
agent_search_enabled = false

# Identity Platform como IdP de los clientes del MCP Gateway (6.G2). Gratis hasta 50 000 MAU,
# pero activarlo en el proyecto NO se deshace (ni con destroy): true solo al validar el gateway.
identity_platform_enabled            = false
identity_platform_authorized_domains = ["localhost"]

# Servidores MCP publicados por HTTPS (Cloud Run, fase 15). Sin ellos no se registra ni se
# despliega nada en Agent Registry ni en Apigee.
mcp_server_urls = {
  # catalog   = "https://genaipocs-mcp-catalog-xxxxxxxxxx.europe-west4.run.app/mcp"
  # ticketing = "https://genaipocs-mcp-ticketing-xxxxxxxxxx.europe-west4.run.app/mcp"
  # refunds   = "https://genaipocs-mcp-refunds-xxxxxxxxxx.europe-west4.run.app/mcp"
}

# Agent Gateway + Agent Registry (6.G3): Limited Preview para Cloud Run; solo us-central1 o
# europe-west1. true solo durante la validación (la política de acceso del agente llega en la 7.G2).
agent_gateway_enabled = false
agent_gateway_region  = "europe-west1"

# Apigee de evaluación (6.G3): gratis 60 días, ~1 h en crearse. Antes del apply, generar los
# bundles: uv run python -m genaipocs_mcp.apigee --signer <mcp_gateway_service_account>
apigee_enabled   = false
apigee_hostnames = ["mcp.genaipocs.internal"]
